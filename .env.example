# Environment variables for MeterVision
# Copy this file to .env.local and fill in your details.

# Get your key from Google AI Studio: https://makersuite.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Get your key from OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Credentials for the initial Super Admin user
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="securepassword123"
ADMIN_EMAIL="admin@metervision.local"

# JWT signing secret. REQUIRED in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left unset, a random key is generated at startup (tokens reset on restart).
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"

# Where uploaded meter images are stored (relative or absolute path).
UPLOAD_DIR="uploads"

# MQTT broker connection for the telemetry listener
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT="1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Base URL of this API, used by the MQTT decoder to post readings back
METERVISION_API_URL="http://127.0.0.1:8000"